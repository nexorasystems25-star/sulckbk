# Database
DATABASE_URL=jdbc:postgresql://localhost:5432/sulck
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
